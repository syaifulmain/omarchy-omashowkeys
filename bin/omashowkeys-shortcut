#!/usr/bin/env bash
# Ensure OmaShowKeys shortcut: SUPER+SHIFT+K toggles keycast on/off.
# Idempotent: exits quietly if binding exists. Safe to run every shell start.
# Called automatically by Panel.qml on load; also runnable by hand.
# Usage:
#   ./bin/omashowkeys-shortcut          # ensure binding
#   ./bin/omashowkeys-shortcut --remove # remove binding
set -euo pipefail

MODE="add"
if [[ "${1:-}" == "--remove" ]]; then MODE="remove"; fi

HYPR_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/hypr"
LUA="$HYPR_DIR/bindings.lua"
CONF="$HYPR_DIR/bindings.conf"
MARKER="syaifulmain.omashowkeys flip"
LUA_COMMENT="-- OmaShowKeys: toggle keycast pill on/off (SUPER+SHIFT+K)"
LUA_LINE='o.bind("SUPER + SHIFT + K", "OmaShowKeys", "omarchy-shell syaifulmain.omashowkeys flip")'
CONF_COMMENT="# OmaShowKeys: toggle keycast pill on/off (SUPER+SHIFT+K)"
CONF_LINE='bindd = SUPER SHIFT, K, OmaShowKeys, exec, omarchy-shell syaifulmain.omashowkeys flip'

add_block() { # $1=file $2=comment $3=line
  local file="$1" comment="$2" line="$3"
  mkdir -p "$(dirname "$file")"
  touch "$file"
  if grep -qF "$MARKER" "$file"; then
    return 0
  fi
  [[ -s "$file" ]] && tail -c1 "$file" | read -r _ || echo >> "$file"
  printf '\n%s\n%s\n' "$comment" "$line" >> "$file"
}

remove_block() { # $1=file
  local file="$1"
  [[ -f "$file" ]] || return 0
  if ! grep -qF "$MARKER" "$file"; then
    return 0
  fi
  tmp="$(mktemp)"
  grep -vF "$MARKER" "$file" | grep -vF "OmaShowKeys: toggle keycast" > "$tmp" || true
  cat -s "$tmp" > "$file"
  rm -f "$tmp"
}

if [[ "$MODE" == "remove" ]]; then
  remove_block "$LUA"
  remove_block "$CONF"
  echo "shortcut removed"
else
  add_block "$LUA" "$LUA_COMMENT" "$LUA_LINE"
  if [[ -f "$CONF" ]]; then
    add_block "$CONF" "$CONF_COMMENT" "$CONF_LINE"
  fi
fi
